# ============================================================================
# PHASE 1: Chunking Configuration
# ============================================================================

# Enable semantic chunking (true/false)
SEMANTIC_CHUNKING_ENABLED=true

# Chunk size parameters (characters)
MIN_CHUNK_SIZE=200
TARGET_CHUNK_SIZE=800
MAX_CHUNK_SIZE=1200

# Overlap between chunks (0.0 to 1.0)
CHUNK_OVERLAP_PERCENTAGE=0.2

# Preserve special content (true/false)
PRESERVE_CODE_BLOCKS=true
PRESERVE_TABLES=true
EXTRACT_METADATA=true

# ============================================================================
# Embedding Configuration
# ============================================================================

# Embedding model
EMBEDDING_MODEL=gemini-embedding-001

# Parallel processing
MAX_EMBEDDING_WORKERS=3
EMBEDDING_BATCH_SIZE=10

# ============================================================================
# Search Configuration
# ============================================================================

# Vector search parameters
MATCH_THRESHOLD=0.3
MATCH_COUNT=10

# Search mode: vector_only, hybrid, keyword_only
SEARCH_MODE=hybrid

# Hybrid search weights (if enabled)
VECTOR_WEIGHT=0.7
KEYWORD_WEIGHT=0.3

# ============================================================================
# PHASE 3: Reranking Configuration (Future)
# ============================================================================

# Enable reranking (true/false)
RERANK_ENABLED=true

# Reranking model: cohere, local, none
RERANK_MODEL=cohere

# Cohere API key (if using Cohere reranking)
# COHERE_API_KEY=your_cohere_api_key

# Reranking parameters
RERANK_CANDIDATES=20
RERANK_TOP_K=5

# ============================================================================
# PHASE 6: Caching Configuration (Future)
# ============================================================================

# Enable caching (true/false)
CACHE_ENABLED=true

# Cache backend: redis, memory
CACHE_BACKEND=memory

# Redis URL (if using Redis)
# REDIS_URL=redis://localhost:6379

# Cache TTL (seconds)
CACHE_TTL_GENERAL=3600
CACHE_TTL_INDEXED=86400

# Similarity threshold for cache hits
CACHE_SIMILARITY_THRESHOLD=0.95

# ============================================================================
# Generation Configuration
# ============================================================================

# Generation model
GENERATION_MODEL=mistral-small-latest

# Fallback models (comma-separated)
# FALLBACK_MODELS=gemini-2.0-flash-lite,gpt-4

# Generation parameters
TEMPERATURE=0.7
MAX_TOKENS=2000
STREAMING_ENABLED=true

# ============================================================================
# PHASE 4: Query Enhancement (Future)
# ============================================================================

# Enable HyDE (Hypothetical Document Embeddings)
HYDE_ENABLED=false

# Enable multi-query generation
MULTI_QUERY_ENABLED=false
QUERY_VARIATIONS=3

# ============================================================================
# PHASE 9: Monitoring Configuration (Future)
# ============================================================================

# Enable metrics collection
METRICS_ENABLED=false
LOG_RETRIEVAL_QUALITY=false
TRACK_LATENCY=false

# ============================================================================
# Feature Flags (Gradual Rollout)
# ============================================================================

# Phase rollout flags
PHASE_1_ENABLED=true
PHASE_2_ENABLED=true
PHASE_3_ENABLED=true
PHASE_4_ENABLED=false
PHASE_5_ENABLED=true
PHASE_6_ENABLED=true

# A/B testing variant: control, treatment
AB_TEST_VARIANT=control
GRAPHRAG_ENABLED=true
AGENTIC_CHUNKING_ENABLED=true